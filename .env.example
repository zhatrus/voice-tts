# ── Engine / models ───────────────────────────────────────
# gpu | cpu  (cpu works but is too slow for telephony — gpu strongly advised)
DEVICE=gpu
# StyleTTS2 Ukrainian multispeaker model (presets + zero-shot cloning)
MODEL_REPO=patriotyk/styletts2_ukrainian_multispeaker
# HF Space that ships the preset voice style files (voices/*.pt)
VOICES_SPACE_REPO=patriotyk/styletts2-ukrainian
# default preset voice name (empty = first available, alphabetically)
DEFAULT_VOICE=
# minutes the model stays in VRAM after last use (0 = never unload)
MODEL_IDLE_TIMEOUT_MIN=30

# ── Output defaults ───────────────────────────────────────
# wav | wav_8k | ulaw_8k | mp3 | ogg   (wav_8k / ulaw_8k = telephony)
DEFAULT_FORMAT=wav
# default output sample rate in Hz (ignored for ulaw_8k/wav_8k which force 8000)
DEFAULT_SAMPLE_RATE=24000

# ── Text front-end ────────────────────────────────────────
# expand numbers/dates/acronyms to words before synthesis (important for IVR).
# Loads an extra CTranslate2 model on first use.
VERBALIZE=true
# reject requests with text longer than this many characters
MAX_TEXT_LEN=3000

# ── Cache ─────────────────────────────────────────────────
# cache rendered audio on disk keyed by text+voice+speed+format (great for IVR
# prompts that repeat). true | false
CACHE_ENABLED=true

# ── Storage ───────────────────────────────────────────────
DATA_DIR=/data

# ── Security ──────────────────────────────────────────────
# if set, every request must send header  X-API-Key: <value>
API_KEY=
# Hugging Face token (optional — raises model download rate limits)
HF_TOKEN=

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
# host port (container always listens on 8000)
PORT=8001
WORKERS=1
LOG_LEVEL=info
